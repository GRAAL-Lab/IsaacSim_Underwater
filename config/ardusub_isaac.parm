FRAME_CONFIG       2
MOT_PWM_MIN        1100
MOT_PWM_MAX        1900
SIM_RATE_HZ        600
# ArduPilot caps MAVLink messages to 80% of the scheduler rate. A 400 Hz
# scheduler permits the bridge's requested 200 Hz SCALED_PRESSURE2 stream.
SCHED_LOOP_RATE    400
AHRS_EKF_TYPE      3
EK3_ENABLE         1
# Enable the built-in SITL GPS so EKF3 has a WGS-84 origin and QGC can show
# GLOBAL_POSITION_INT.  GPS is not selected as an EKF position/velocity source.
GPS1_TYPE          1
VISO_TYPE          1
VISO_QUAL_MIN      1
VISO_VEL_M_NSE     0.05
VISO_POS_M_NSE     0.05
# ODOMETRY contains local NED position plus DVL-derived velocity.  Selecting
# ExternalNav (6) for both lets Position Hold use those measurements.
EK3_SRC1_POSXY     6
EK3_SRC1_VELXY     6
EK3_SRC1_POSZ      1
EK3_SRC1_VELZ      6
EK3_SRC1_YAW       1
EK3_SRC_OPTIONS    0
RNGFND1_TYPE       10
RNGFND1_ORIENT     25
RNGFND1_MIN        0.05
RNGFND1_MAX        50
MAV_GCS_SYSID      42
# RC override commands are generated by KCL, not a noisy physical joystick.
# Remove ArduSub's default 30-40 us input dead zones so sub-decimetre pose
# corrections are not discarded around the 1500 us neutral point.
RC1_DZ             0
RC2_DZ             0
RC3_DZ             0
RC4_DZ             0
RC5_DZ             0
RC6_DZ             0
THR_DZ             0
SIM_BARO_RND       0.02
SIM_MAG_RND        1.6
BARO_SPEC_GRAV     1.0
