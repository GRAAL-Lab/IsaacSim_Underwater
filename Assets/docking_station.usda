                asset inputs:file = @./textures/DICT_4X4_1000_4f.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SDF_Model_Root/_materials/Plate_003/uvmap.outputs:result>
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "Cube_mesh_map_0"
                float2 outputs:result
            }
        }
    }

}
